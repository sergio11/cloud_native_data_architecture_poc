# -----------------------------------------------------------------------------
*.parquet
*.avro
*.orc
*.csv
*.tsv
*.jsonl
data/
lakehouse/
warehouse/
checkpoint/
checkpoints/
iceberg-data/
# Local databases created in the working directory (lineage webhook service
# writes lineage_events.db to $PWD; data/ is already fully ignored above)
/*.db

# -----------------------------------------------------------------------------
# MinIO / S3 local mirror
# -----------------------------------------------------------------------------
.minio.sys/
minio-data/

# -----------------------------------------------------------------------------
# Dagster
