# Normalize line endings to LF on commit
* text=auto eol=lf

# Force LF for shell scripts and YAML regardless of platform
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Binary files — do not touch
*.parquet binary
*.avro binary
*.orc binary
*.gz binary
*.zip binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
