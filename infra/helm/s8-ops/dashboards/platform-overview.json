    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "title": "Active Startup Profile",
      "type": "stat",
      "targets": [
        {
          "expr": "vector(1)",
          "format": "time_series",
          "legendFormat": "DEMO (RF-24)",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "title": "Total RAM Consumed (MB)",
      "type": "gauge",
      "fieldConfig": {
        "defaults": {
          "max": 8192,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 6000 },
              { "color": "red", "value": 7500 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=~'platform|sales|marketing|finance|ops'}) / 1024 / 1024",
          "legendFormat": "Total RAM",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "title": "Stream E2E Latency (s)",
      "type": "gauge",
      "fieldConfig": {
        "defaults": {
          "max": 10,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "flink_taskmanager_job_latency_source_to_sink_seconds{job_name=~'.*orders.*'}",
          "legendFormat": "Stream Latency",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "title": "Data Quality Pass Rate (%)",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 90 },
              { "color": "green", "value": 98 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "avg(data_quality_assertion_success_ratio) * 100",
          "legendFormat": "Overall Quality",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    }
  ],
